<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Evolith.Ums.Sdk.Authorization</PackageId>
    <Version>1.0.0</Version>
    <Description>UMS SDK — Pure authorization validator (deny-wins, override, expiry, schema-version compatibility), accessor port, ASP.NET Core integration and Result-pattern denial behavior. See ADR-0073.</Description>
    <Authors>Evolith UMS</Authors>
    <PackageProjectUrl>https://github.com/beyondnetcode/ums</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ums;sdk;authorization;validator;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <UmsSchemaCompatibility>&gt;=1.0.0 &lt;2.0.0</UmsSchemaCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Evolith.Ums.Sdk.Contracts/Evolith.Ums.Sdk.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Evolith.Ums.Sdk.Authorization.Aop" />
    <InternalsVisibleTo Include="Evolith.Ums.Sdk.Authorization.Testing" />
    <InternalsVisibleTo Include="Evolith.Ums.Sdk.Tests" />
  </ItemGroup>

</Project>
