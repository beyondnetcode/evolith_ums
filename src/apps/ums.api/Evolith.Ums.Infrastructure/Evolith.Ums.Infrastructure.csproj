<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

    <ItemGroup>
    <ProjectReference Include="../Evolith.Ums.Domain/Evolith.Ums.Domain.csproj" />
    <ProjectReference Include="../Evolith.Ums.Application/Evolith.Ums.Application.csproj" />
    <ProjectReference Include="../Evolith.Ums.Globalization/Evolith.Ums.Globalization.csproj" />
    <ProjectReference Include="../Evolith.Ums.ReadModels/Evolith.Ums.ReadModels.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- AOP: DispatchProxy-based aspect-oriented infrastructure -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageReference Include="BeyondNetCode.Shell.Aop.DI" Version="1.0.0" />
    <PackageReference Include="BeyondNetCode.Shell.Aop.Aspects.Logger.Serilog" Version="1.0.0" />
    <PackageReference Include="BeyondNetCode.Shell.Factory.Installer" Version="1.0.0" />
    <PackageReference Include="MassTransit" Version="8.3.1" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.3.1" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.5.0" /> <!-- REC-08: Polly circuit breaker -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.7" /> <!-- OPS-01: Redis token revocation store -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/*.sql" />
    <!--
      El logo que llevan los correos. Va INCRUSTADO en el ensamblado, no leído del disco: un
      fichero suelto se pierde en el primer despliegue que copie solo binarios, y la alternativa
      —enlazar la imagen del portal— no carga fuera de la red y la bloquean los clientes de correo.
    -->
    <EmbeddedResource Include="Services/Notifications/Assets/*.png" />
  </ItemGroup>

</Project>