{
  "name": "app-api-dotnet",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build Evolith.Ums.sln",
        "cwd": "apps/ums.api"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test Evolith.Ums.sln",
        "cwd": "apps/ums.api"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project Evolith.Ums.Presentation",
        "cwd": "apps/ums.api"
      }
    }
  }
}
