{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": "",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Persistence": {
    "Provider": "PostgreSql",
    "AggregateStoreMode": "PostgreSql",
    "UsePostgreSqlIdentityStores": true,
    "UsePostgreSqlAuthorizationStores": true,
    "UsePostgreSqlConfigurationStores": true,
    "UsePostgreSqlApprovalsStores": true,
    "UsePostgreSqlIgaStores": true,
    "SeedDevData": true,
    "EnableOutbox": true,
    "InitializePlatformStoreOnStartup": true
  },
  "Secrets": {
    "Source": "AppSettings",
    "KeyVault": {
      "Url": "",
      "UseManagedIdentity": true
    }
  },
  "ApiSettings": {
    "RateLimiting": {
      "PermitLimit": 250,
      "WindowMinutes": 1
    },
    "MaxRequestBodySize": 10485760,
    "EnableSwagger": true
  },
  "Notifications": {
    "PortalBaseUrl": "http://srvtms:8080/ums_web",
    "Provider": "Smtp",
    "Smtp": {
      "Host": "smtp.sendgrid.net",
      "Port": 25,
      "UseStartTls": true,
      "User": "apikey",
      "Password": "",
      "FromAddress": "sistemas@evolith.example",
      "FromName": "UMS - Evolith"
    }
  },
  "Observability": {
    "Logging": {
      "MinimumLevel": "Information",
      "ConsoleFormat": "CompactJson",
      "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] trace={TraceId} span={SpanId} {SessionTrackingId} {SourceContext} {Message:lj}{NewLine}{Exception}",
      "LokiEnvLabel": "uat"
    },
    "Tracing": {
      "OtlpEndpoint": "",
      "ServiceVersion": "1.0.0-uat"
    }
  }
}
