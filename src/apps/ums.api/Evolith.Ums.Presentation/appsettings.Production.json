{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": "",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Persistence": {
    "Provider": "PostgreSql",
    "AggregateStoreMode": "PostgreSql",
    "SeedDevData": false,
    "EnableOutbox": true,
    "InitializePlatformStoreOnStartup": false,
    "Bootstrap": {
      "Enabled": false,
      "CredentialMode": "OneTimeToken",
      "InitialSecretEnvVar": "UMS_BOOTSTRAP_TOKEN",
      "AdminEmailEnvVar": "UMS_BOOTSTRAP_EMAIL",
      "InitialSecretLifetimeMinutes": 60,
      "RequireEmptyUserTable": true
    }
  },
  "Secrets": {
    "Source": "AppSettings",
    "KeyVault": {
      "Url": "https://your-vault-name.vault.azure.net/",
      "UseManagedIdentity": true
    }
  },
  "ApiSettings": {
    "RateLimiting": {
      "PermitLimit": 100,
      "WindowMinutes": 1
    },
    "MaxRequestBodySize": 10485760,
    "EnableSwagger": false
  },
  "Notifications": {
    "PortalBaseUrl": "",
    "Provider": "Smtp",
    "Smtp": {
      "Host": "smtp.sendgrid.net",
      "Port": 25,
      "UseStartTls": true,
      "User": "apikey",
      "Password": "",
      "FromAddress": "sistemas@evolith.example",
      "FromName": "UMS - Evolith"
    }
  },
  "Observability": {
    "Logging": {
      "MinimumLevel": "Information",
      "ConsoleFormat": "CompactJson",
      "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] trace={TraceId} span={SpanId} {SessionTrackingId} {SourceContext} {Message:lj}{NewLine}{Exception}"
    },
    "Tracing": {
      "OtlpEndpoint": "",
      "ServiceVersion": "1.0.0"
    }
  }
}
