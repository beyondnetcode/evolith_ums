# =============================================================================
# UMS Web App — Environment Configuration
# =============================================================================

# =============================================================================
# DATA SOURCE MODE
# =============================================================================
# Choose one of three modes:
#
#   1. MOCK MODE (local without database):
#      VITE_USE_MOCKS=true
#      Uses hardcoded mock data in src/test/mocks/
#      No backend required - all data is fake
#
#   2. LOCAL DB MODE (SQLite local database):
#      VITE_USE_MOCKS=false
#      VITE_API_URL=http://localhost:7114 (or https://localhost:7114)
#      Uses the local API with SQLite database
#
#   3. PRODUCTION MODE (real database):
#      VITE_USE_MOCKS=false
#      VITE_API_URL=https://ums-api.your-domain.com
#      Uses the production API with production database

VITE_USE_MOCKS=false

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Base path for REST API requests (relative to dev server for proxy)
VITE_API_BASE_PATH=/api/v1

# Base URL for the backend API
VITE_API_URL=https://localhost:7114

# GraphQL endpoint path (relative to dev server for proxy)
VITE_GRAPHQL_PATH=/graphql

# =============================================================================
# INQUILINOS DE LA PANTALLA DE INGRESO (G-263)
# =============================================================================
# El campo «Inquilino» del ingreso es de TEXTO LIBRE: el usuario escribe el código de su
# organización, que es lo único que consume `POST /api/v1/auth/login`. Estas dos variables
# solo ahorran tecleo; ninguna limita a quién puede entrar.
#
# Sugerencias que ofrece el desplegable. Sin ella no se ofrece ninguna fuera de desarrollo
# —en desarrollo se ofrecen las del sembrador—. Formato: CODIGO|Nombre visible, separados
# por comas; el nombre es opcional.
# VITE_TENANT_CODES=EVOLITH|Evolith UMS,COMEX_ANDINA|Comercializadora Andina S.A.C.
#
# Código con el que arranca el campo. Sin ella arranca en la primera sugerencia y, si no hay
# ninguna, en EVOLITH (inquilino raíz, ADR-0071/FS-26). Siempre es editable.
# VITE_DEFAULT_TENANT_CODE=EVOLITH
